# Copy to .env.local and fill in. Everything here has a working local default
# except ADMIN_PASSWORD, SESSION_SECRET and ANTHROPIC_API_KEY.

# ---------------------------------------------------------------- required ---

# Shared password for the hiring team.
ADMIN_PASSWORD=change-me

# Secret for signing the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me

# Needed to read resumes. Without it, upload and submission still work and every
# candidate falls back to filling the form in by hand.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- optional ---

# Model used for field extraction and for reading scanned PDFs.
# Defaults to claude-opus-5. Set claude-sonnet-5 to trade some extraction
# accuracy for lower cost per resume.
# ANTHROPIC_MODEL=claude-opus-5

# Absolute base URL, used to build withdrawal and share links.
APP_BASE_URL=http://localhost:3000

# Addresses shown in the DPDP notice and the duplicate-block message.
ORGANISATION_NAME=Your Organisation
RECRUITMENT_EMAIL=recruitment@example.com
DPO_EMAIL=dpo@example.com

# ------------------------------------------------------------------ cloud ----
# Leave all of these unset to run fully locally: embedded Postgres, resumes on
# disk, and Cloudflare's always-passes Turnstile test keys.

# Set to a Neon (or any Postgres) connection string to use a real database.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Set to move resume storage to Vercel Blob.
# BLOB_READ_WRITE_TOKEN=

# Real Turnstile keys. Without these the documented test keys are used, which
# always pass — fine locally, never in production.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Shared secret Vercel Cron presents to the daily sweep. Required in production:
# without it the sweep route refuses to run rather than being left public.
# CRON_SECRET=
